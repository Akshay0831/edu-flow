import 'package:flutter_test/flutter_test.dart';
import 'package:provider/provider.dart';
import 'package:flutter/material.dart';

// Mock service class
class MockAuthService extends ChangeNotifier {
  bool _checkMfaStatusValue = false;
  String _getUserRoleValue = 'student';

  bool get checkMfaStatus => _checkMfaStatusValue;
  String get getUserRole => _getUserRoleValue;

  void setCheckMfaStatus(bool value) {
    _checkMfaStatusValue = value;
    notifyListeners();
  }

  void setUserRole(String value) {
    _getUserRoleValue = value;
    notifyListeners();
  }
}

void main() {
  group('MFA Integration Tests', () {
    late MockAuthService mockAuthService;

    setUp(() {
      mockAuthService = MockAuthService();
    });

    testWidgets('MfaSetup widget should load and display correctly', (WidgetTester tester) async {
      // Mock initial state
      mockAuthService.setCheckMfaStatus(false);
      mockAuthService.setUserRole('student');

      await tester.pumpWidget(
        MaterialApp(
          home: ChangeNotifierProvider<MockAuthService>.value(
            value: mockAuthService,
            child: const Scaffold(
              body: Text('MFA Test'),
            ),
          ),
        ),
      );

      // Wait for loading to complete
      await tester.pumpAndSettle();

      // Verify widget is loaded
      expect(find.byType(Scaffold), findsOneWidget);
      expect(find.text('MFA Test'), findsOneWidget);
    });

    testWidgets('MockAuthService state management works correctly', (WidgetTester tester) async {
      // Mock initial state
      mockAuthService.setCheckMfaStatus(false);
      mockAuthService.setUserRole('student');

      await tester.pumpWidget(
        MaterialApp(
          home: ChangeNotifierProvider<MockAuthService>.value(
            value: mockAuthService,
            child: const Scaffold(
              body: Text('MFA Test'),
            ),
          ),
        ),
      );

      await tester.pumpAndSettle();

      // Verify initial state
      expect(mockAuthService.checkMfaStatus, false);
      expect(mockAuthService.getUserRole, 'student');

      // Update state
      mockAuthService.setCheckMfaStatus(true);
      mockAuthService.setUserRole('admin');

      await tester.pumpAndSettle();

      // Verify updated state
      expect(mockAuthService.checkMfaStatus, true);
      expect(mockAuthService.getUserRole, 'admin');
    });

    testWidgets('MockAuthService triggers rebuild on state change', (WidgetTester tester) async {
      // Mock initial state
      mockAuthService.setCheckMfaStatus(false);
      mockAuthService.setUserRole('student');

      await tester.pumpWidget(
        MaterialApp(
          home: ChangeNotifierProvider<MockAuthService>.value(
            value: mockAuthService,
            child: Consumer<MockAuthService>(
              builder: (context, value, child) {
                return Text('MFA: ${value.checkMfaStatus}');
              },
            ),
          ),
        ),
      );

      await tester.pumpAndSettle();

      // Verify initial state display
      expect(find.text('MFA: false'), findsOneWidget);

      // Update state
      mockAuthService.setCheckMfaStatus(true);

      await tester.pumpAndSettle();

      // Verify UI updates
      expect(find.text('MFA: true'), findsOneWidget);
      expect(find.text('MFA: false'), findsNothing);
    });
  }
}