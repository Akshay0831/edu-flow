{
  "database": {
    "database_type": "sqlite",
    "host": "localhost",
    "port": 5432,
    "username": "postgres",
    "password": "test_password",
    "database": "edu_flow",
    "pool_size": 10,
    "pool_recycle": 3600,
    "connection_timeout": 30
  },
  "cache": {
    "backend": "memory",
    "host": "localhost",
    "port": 6379,
    "database": 0,
    "key_prefix": "edu_flow:",
    "ttl": 3600,
    "max_memory_size": 1073741824
  },
  "models": {
    "performance_prediction": {
      "model_type": "random_forest",
      "model_path": "models/performance_prediction.pt",
      "model_version": "1.0.0",
      "framework": "candle",
      "device": "cpu",
      "preprocessing": {
        "normalize": true,
        "handle_missing": "mean",
        "encoding_method": "onehot"
      },
      "postprocessing": {
        "confidence_threshold": 0.7,
        "risk_threshold": 0.6,
        "explainability": true
      },
      "evaluation_metrics": [
        "mae",
        "rmse",
        "r2_score",
        "accuracy"
      ]
    },
    "course_recommendation": {
      "model_type": "collaborative_filtering",
      "model_path": "models/course_recommendation.pt",
      "model_version": "1.0.0",
      "framework": "candle",
      "device": "cpu",
      "preprocessing": {
        "normalize": true,
        "handle_missing": "mean",
        "embedding_model": "sentence_transformers"
      },
      "postprocessing": {
        "confidence_threshold": 0.65,
        "risk_threshold": 0.5,
        "explainability": true
      },
      "evaluation_metrics": [
        "precision",
        "recall",
        "f1_score"
      ]
    },
    "knowledge_search": {
      "model_type": "bert",
      "model_path": "models/knowledge_search.pt",
      "model_version": "1.0.0",
      "framework": "candle",
      "device": "cpu",
      "preprocessing": {
        "normalize": true,
        "handle_missing": "drop",
        "embedding_model": "bert"
      },
      "postprocessing": {
        "confidence_threshold": 0.7,
        "risk_threshold": 0.5,
        "explainability": true
      },
      "evaluation_metrics": [
        "precision",
        "recall",
        "map"
      ]
    },
    "adaptive_learning": {
      "model_type": "neural_network",
      "model_path": "models/adaptive_learning.pt",
      "model_version": "1.0.0",
      "framework": "candle",
      "device": "cpu",
      "preprocessing": {
        "normalize": true,
        "handle_missing": "mean",
        "encoding_method": "onehot"
      },
      "postprocessing": {
        "confidence_threshold": 0.7,
        "risk_threshold": 0.6,
        "explainability": true
      },
      "evaluation_metrics": [
        "mae",
        "rmse",
        "accuracy"
      ]
    }
  },
  "services": {
    "course_recommendation": {
      "service_name": "course_recommendation",
      "service_type": "ai_service",
      "api_endpoint": "http://localhost:8002",
      "timeout": 30,
      "retry_attempts": 3,
      "retry_delay": 1,
      "rate_limit": 100,
      "enable_metrics": true
    },
    "knowledge_search": {
      "service_name": "knowledge_search",
      "service_type": "ai_service",
      "api_endpoint": "http://localhost:8003",
      "timeout": 30,
      "retry_attempts": 3,
      "retry_delay": 1,
      "rate_limit": 100,
      "enable_metrics": true
    },
    "adaptive_learning": {
      "service_name": "adaptive_learning",
      "service_type": "ai_service",
      "api_endpoint": "http://localhost:8004",
      "timeout": 30,
      "retry_attempts": 3,
      "retry_delay": 1,
      "rate_limit": 100,
      "enable_metrics": true
    }
  },
  "monitoring": {
    "enable_metrics": true,
    "metrics_port": 9090,
    "enable_tracing": true,
    "tracing_endpoint": "http://localhost:14268/api/traces",
    "log_level": "INFO"
  },
  "registry": {
    "registry_type": "memory",
    "registry_url": null,
    "discovery_interval": 30,
    "health_check_interval": 15,
    "grace_period": 30
  }
}
